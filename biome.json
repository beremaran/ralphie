{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": ["**", "!!dist", "!!coverage"]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "overrides": [
    {
      "includes": [
        "tests/integration/command-runtime-harness.ts",
        "tests/integration/command-runtime-scenario.test.ts"
      ],
      "formatter": {
        "trailingNewline": true
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 12
          }
        }
      }
    }
  },
  "assist": {
    "enabled": false
  }
}