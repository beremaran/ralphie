{
  "branch": "main",
  "maxIssues": 10,
  "issueLabels": ["bug"],
  "issueSort": "created",
  "issueOrder": "asc",
  "model": "openai/gpt-5",
  "modelVariant": "medium",
  "agent": "build",
  "workspace": "~/.ralphie",
  "startClean": false,
  "cleanup": false,
  "dryRun": false,
  "verbose": false,
  "json": false,
  "quiet": false,
  "repositories": [
    {
      "repo": "owner/frontend",
      "issueLabels": ["frontend"]
    },
    {
      "repo": "owner/backend",
      "branch": "develop",
      "maxIssues": 5,
      "issueLabels": ["backend"]
    }
  ]
}
