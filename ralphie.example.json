{
  "workflow": "lgtm",
  "dryRun": false,
  "git": {
    "branch": "main"
  },
  "issues": {
    "sort": {
      "by": "created",
      "order": "asc"
    },
    "limit": 10,
    "filter": {
      "labels": ["bug"]
    }
  },
  "workspace": {
    "path": "~/.ralphie",
    "cleanup": {
      "before": true,
      "after": true
    }
  },
  "output": {
    "verbose": false,
    "quiet": false,
    "json": false
  },
  "agent": {
    "model": {
      "id": "openai/gpt-5",
      "variant": "medium"
    },
    "mode": "build"
  },
  "projects": [
    {
      "name": "proj-a",
      "repoPattern": "some-owner/project-xyz-*"
    },
    {
      "name": "proj-b",
      "repositories": [
        {
          "repo": "owner/frontend",
          "issues": {
            "filter": {
              "labels": ["frontend"]
            }
          }
        },
        {
          "repo": "owner/backend",
          "git": {
            "branch": "develop"
          },
          "issues": {
            "limit": 5,
            "filter": {
              "labels": ["backend"]
            }
          }
        }
      ]
    },
    {
      "name": "lonely-repo",
      "repositories": [
        {
          "repo": "some-owner/some-repo"
        }
      ]
    }
  ]
}
