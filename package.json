{
  "name": "ralphie",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "ralphie": "./index.ts"
  },
  "exports": {
    ".": {
      "import": "./index.ts"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "bunli": "^0.9.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@bunli/core": "^0.9.1",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "effect": "^3.22.1",
    "execa": "^10.0.1",
    "octokit": "^5.0.5",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3",
    "zx": "^8.8.5"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bunli dev --entry ./src/cli.ts",
    "build": "bunli build --targets native",
    "check": "bun run format:check && bun run typecheck && bun test && bun run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "probe:structured-output": "bun run scripts/probe-structured-output.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  }
}
