{
  "name": "ralphie",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "ralphie": "./index.ts"
  },
  "exports": {
    ".": {
      "import": "./index.ts"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "octokit": "^5.0.5",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch ./index.ts",
    "build": "bun build ./index.ts --compile --outfile ./dist/cli",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "probe:structured-output": "bun run scripts/probe-structured-output.ts",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit"
  }
}