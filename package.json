{
  "name": "@beremaran/ralphie",
  "version": "0.1.2",
  "description": "Turn a GitHub issue queue into reviewed commits with OpenCode.",
  "module": "./dist/ralphie.js",
  "main": "./dist/ralphie.js",
  "type": "module",
  "bin": {
    "ralphie": "./dist/ralphie.js"
  },
  "exports": {
    ".": "./dist/ralphie.js"
  },
  "files": [
    "dist/ralphie.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/architecture.md",
    "docs/cli-reference.md",
    "docs/development.md",
    "docs/end-to-end-execution.md",
    "docs/getting-started.md",
    "docs/operations-and-recovery.md",
    "docs/README.md",
    "docs/safety.md",
    "docs/workflows.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/beremaran/ralphie"
  },
  "homepage": "https://github.com/beremaran/ralphie",
  "bugs": {
    "url": "https://github.com/beremaran/ralphie/issues"
  },
  "license": "MIT",
  "keywords": [
    "bun",
    "cli",
    "github",
    "github-issues",
    "automation",
    "ai",
    "opencode",
    "npm"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "ajv": "8.17.1",
    "typescript": "^5"
  },
  "dependencies": {
    "@opencode-ai/client": "^0.0.0-beta-18999",
    "octokit": "^5.0.5",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch ./index.ts",
    "build": "bun run scripts/build.ts",
    "build:package": "bun run scripts/build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "package:check": "bun run scripts/package-smoke.ts",
    "package:inspect": "bun run scripts/package-smoke.ts --dry-run",
    "prepack": "bun run build:package",
    "probe:structured-output": "bun run scripts/probe-structured-output.ts",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit"
  }
}