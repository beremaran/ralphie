# Keep the Docker context limited to the inputs consumed by Dockerfile.
# This is intentionally deny-by-default: update this allowlist when the build
# starts requiring another file. Dockerfile and .dockerignore are supplied to
# the builder automatically and are not copied into the image.
*
!package.json
!bun.lock
!index.ts
!src/
!src/**
!scripts/
scripts/*
!scripts/build.ts

# Keep local, generated, and secret material excluded even under an allowed
# source directory. These rules must remain after the allowlist above.
.git
.git/**
.github
.github/**
node_modules
**/node_modules/**
dist
**/dist/**
out
**/out/**
build
**/build/**
coverage
**/coverage/**
**/.ralphie
**/.ralphie/**
workspace/**
state/**
.ralphie-workspace/**
.ralphie-state/**
tests/**

# Credentials, dotenv files, local configuration, and private keys. The
# deny-by-default rule above is the primary boundary; these rules also protect
# any matching file that is placed below an allowed source directory.
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
**/.npmrc
**/.yarnrc*
**/.netrc
**/.pypirc
**/.aws
**/.aws/**
**/.azure
**/.azure/**
**/.config
**/.config/**
**/.docker
**/.docker/**
**/.gnupg
**/.gnupg/**
**/.kube
**/.kube/**
**/.pi
**/.pi/**
**/.ssh
**/.ssh/**
**/*credentials*
**/*credential*
**/*secret*
**/*token*
**/*password*
**/*apikey*
**/*api-key*
**/*private*
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.der
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa*
**/id_ed25519*

# Logs, editor metadata, and other generated or test output.
*.log
**/*.log
logs
**/logs/**
.idea
**/.idea/**
.vscode
**/.vscode/**
.DS_Store
**/.DS_Store
**/*~
**/*.swp
**/*.swo
**/*.lcov
**/.nyc_output/**
**/test-results/**
**/playwright-report/**
